# Python environments and caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Credentials and local settings
.env
.env.*
!.env.example
*.pem
*.key
.vscode/
.idea/
Thumbs.db
Desktop.ini
~$*

# Local materials: review and obtain consent before tracking
/01_Problem/*
!/01_Problem/.gitkeep
/02_References/*
!/02_References/.gitkeep
/03_Data/*
!/03_Data/.gitkeep
/05_Results/*
!/05_Results/.gitkeep
/06_Paper/*
!/06_Paper/.gitkeep
/07_Notes/*
!/07_Notes/.gitkeep

# New simplified layout: only shared guides are allowed by default
/problem/*
!/problem/README.md
/results/*
!/results/README.md
/paper/*
!/paper/README.md
!/paper/references/
/paper/references/*
!/paper/references/README.md

# Legacy private material stays local after archiving
/.archive/legacy-framework/01_Problem/*
!/.archive/legacy-framework/01_Problem/.gitkeep
/.archive/legacy-framework/02_References/*
!/.archive/legacy-framework/02_References/.gitkeep
/.archive/legacy-framework/03_Data/*
!/.archive/legacy-framework/03_Data/.gitkeep
/.archive/legacy-framework/05_Results/*
!/.archive/legacy-framework/05_Results/.gitkeep
/.archive/legacy-framework/06_Paper/*
!/.archive/legacy-framework/06_Paper/.gitkeep
/.archive/legacy-framework/07_Notes/*
!/.archive/legacy-framework/07_Notes/.gitkeep
